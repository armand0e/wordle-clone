{
  "name": "wordle-party",
  "version": "0.1.1",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "ts-node --project tsconfig.server.json server.ts",
    "build": "npm run build:app && npm run build:server",
    "build:app": "next build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/src/lib',{recursive:true});fs.copyFileSync('src/lib/official-wordlists.json','dist/src/lib/official-wordlists.json');\"",
    "start": "node -e \"process.env.NODE_ENV='production';require('./dist/server.js')\"",
    "words:refresh": "python five_letter_list.py",
    "smoke:test:2p": "node scripts/two-player-smoke-test.mjs",
    "lint": "eslint",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
